# SEC requires a descriptive User-Agent with real contact information.
# Filling this in with something generic risks an IP block. PRD 6.1.
SEC_USER_AGENT="FilingQA Research Project your.name@example.com"

DATABASE_URL="postgresql://filingqa:filingqa@localhost:5432/filingqa"

# Where raw, normalized and parsed documents land. Gitignored.
DATA_DIR="./data"

# Generation (PRD 12: the only provider key CI carries). Needed by the Phase 2
# baseline's answer step; retrieval runs without it.
ANTHROPIC_API_KEY=
